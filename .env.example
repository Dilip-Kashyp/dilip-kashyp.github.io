QDRANT_URL=https://your-cluster.qdrant.io
QDRANT_API_KEY=replace-me
QDRANT_COLLECTION=personal_portfoilo
QDRANT_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
KNOWLEDGE_FILE=data/knowledge.md
DEFAULT_TOP_K=5
DEFAULT_GRAPH_DEPTH=2
DEFAULT_MAX_GRAPH_NODES=20
KB_PATH=/absolute/path/to/knowledge-base
KB_NODES_COLLECTION=kb_nodes
KB_EDGES_COLLECTION=kb_edges
KB_META_COLLECTION=kb_meta
# Optional provider. The API also accepts a trusted precomputed queryVector.
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
